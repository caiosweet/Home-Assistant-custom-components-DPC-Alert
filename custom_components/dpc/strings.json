            "user": {
                "title": "Civil Protection Department",
                "description": "How do you want to choose the place to monitor? The DPC bulletins cover Italy.",
                "menu_options": {
                    "map": "Pick it on a map",
                    "zone": "Use a zone, such as Home"
                }
            },
            "map": {
                "title": "Place on the map",
                "description": "Move the pin to the place to monitor.",
                "data": {
                    "location": "Place"
                },
                "data_description": {
                    "location": "The place must be in Italy: the DPC bulletins cover Italy only."
                }
            },
            "zone": {
                "title": "Place of a zone",
                "description": "Choose one of your zones in Home Assistant.",
                "data": {
                    "zone": "Zone"
                },
                "data_description": {
                    "zone": "The place of the zone is copied: moving the zone later does not move the place."
                }
            },
            "municipality": {
                "title": "Municipality",
