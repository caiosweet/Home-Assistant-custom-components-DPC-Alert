{
    "title": "Civil Protection Department",
    "config": {
        "flow_title": "{name}",
        "step": {
            "user": {
                "title": "Civil Protection Department",
                "description": "How do you want to choose the place to monitor? The DPC bulletins cover Italy.",
                "menu_options": {
                    "map": "Pick it on a map",
                    "zone": "Use a zone, such as Home"
                }
            },
            "map": {
                "title": "Place on the map",
                "description": "Move the pin to the place to monitor.",
                "data": {
                    "location": "Place"
                },
                "data_description": {
                    "location": "The place must be in Italy: the DPC bulletins cover Italy only."
                }
            },
            "zone": {
                "title": "Place of a zone",
                "description": "Choose one of your zones in Home Assistant.",
                "data": {
                    "zone": "Zone"
                },
                "data_description": {
                    "zone": "The place of the zone is copied: moving the zone later does not move the place."
                }
            },
            "municipality": {
                "title": "Municipality",
                "description": "The place is in the DPC alert zone **{zone}**. Choose its municipality.",
                "data": {
                    "municipality": "Municipality"
                },
                "data_description": {
                    "municipality": "Large municipalities span several alert zones: the place then gets the highest alert of all of them. Each municipality can be added once."
                }
            },
            "display": {
                "title": "What to show",
                "description": "You can change them later in the options.",
                "data": {
                    "days": "Days",
                    "entities": "Entities"
                },
                "data_description": {
                    "days": "Each chosen day gets a device with its alerts, precipitation, maps and phenomena.",
                    "entities": "Unchecking a kind removes its entities from the place and from every day."
                }
            },
            "alerts": {
                "title": "Alerts",
                "description": "You can change them later in the options.",
                "data": {
                    "warning_level": "Minimum level of warning",
                    "radius": "Radius of the phenomena",
                    "scan_interval": "Update interval"
                },
                "data_description": {
                    "warning_level": "The binary sensor of each risk turns on from this level up. With No alert, it is always on.",
                    "radius": "Weather phenomena within this distance of the place, in km (default 50).",
                    "scan_interval": "Minutes between checks for new bulletins (default 30)."
                }
            }
        },
        "error": {
            "coordinates_outside": "Coordinates are outside DPC alert areas.",
            "cannot_connect": "Unable to validate coordinates. Check your connection.",
            "zone_not_found": "The zone was not found.",
            "municipality_in_use": "{municipality} is already configured: each municipality can be added once.",
            "municipality_not_listed": "Choose a municipality of the list."
        },
        "abort": {
            "single_instance_allowed": "Multiple instances are supported. Each location can be added once.",
            "already_configured": "An entry for this location is already configured."
        },
        "create_entry": {
            "default": "To see the alerts on a dashboard, go to **Settings → Dashboards → Add dashboard** and choose **DPC Alert** among the community dashboards. If it is not listed, reload the page."
        }
    },
