                    "location": "地点必须位于意大利：DPC 公报仅覆盖意大利。"
                }
            },
            "zone": {
                "title": "区域的地点",
                "description": "选择 Home Assistant 中的一个区域。",
                "data": {
                    "zone": "区域"
                },
                "data_description": {
                    "zone": "将复制区域的位置：之后移动区域不会移动该地点。"
                }
            },
            "municipality": {
                "title": "市镇",
                "description": "该地点位于 DPC 预警区 **{zone}**。请选择其市镇。",
                "data": {
                    "municipality": "市镇"
                },
                "data_description": {
                    "municipality": "大型市镇跨越多个预警区：该地点将获得其中最高的预警。每个市镇只能添加一次。"
                }
            },
            "display": {
                "title": "显示内容",
                "description": "之后可以在选项中更改。",
                "data": {
                    "days": "日期",
                    "entities": "实体"
                },
                "data_description": {
                    "days": "每个选中的日期都会有一个设备，包含其预警、降水、地图和现象。",
                    "entities": "取消勾选某一类型会从该地点和每一天中删除其实体。"
                }
            },
            "alerts": {
                "title": "预警",
                "description": "之后可以在选项中更改。",
                "data": {
                    "warning_level": "最低预警级别",
