                }
            }
        }
    },
    "exceptions": {
        "update_failed": {
            "message": "Не вдалося отримати жодного бюлетеня DPC: {error}"
        },
        "outside_alert_zones": {
            "message": "{place} не входить до жодної зони попередження DPC."
        }
    }
}
